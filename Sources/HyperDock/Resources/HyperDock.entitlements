<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Sandbox must be OFF. A sandboxed process cannot call
	  AXUIElementCopyAttributeValue against other applications, which is the
	  entire basis of Dock introspection and window control.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!--
	  Hardened runtime is ON (project setting) and does not interfere with
	  Accessibility or ScreenCaptureKit. These exceptions allow the dynamic
	  resolution of the CoreGraphics CGS/SkyLight symbols we bind via dlsym.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
