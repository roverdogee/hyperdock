      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加绑定"
          }
        }
      }
    },
    "Add an app…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用…"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Any Dock Item": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任意程序坞项目"
          }
        }
      }
    },
    "Appear with": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出动画"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Application name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用名称"
          }
        }
      }
    },
    "Applies to every Dock icon unless an app below overrides it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有程序坞图标，下方单独设置的应用会覆盖此处。"
          }
        }
      }
    },
    "Applies while dragging with the move keys held (%@). Pause near an edge to see where the window will land. While this is on, macOS's own drag-to-edge tiling is switched off so the two do not both react to one drag; turning it off puts macOS's back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在按住移动快捷键（%@）拖动时生效。靠近边缘稍作停留即可看到窗口将落在何处。开启期间会关闭 macOS 自带的边缘拖拽平铺，避免同一次拖动被两套逻辑同时响应；关闭本项会把系统平铺还原。"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Behaviour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行为"
          }
        }
      }
    },
    "Behaviour:": {
      "localizations": {
        "zh-Hans": {
