{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "+ Arrow/Numpad Keys": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 方向键 / 小键盘数字键"
          }
        }
      }
    },
    "+ Left mouse button": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 鼠标左键"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility access is required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限"
          }
        }
      }
    },
    "Accessibility lets HyperDock read the Dock and control windows. Screen Recording provides thumbnails and window titles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能用于读取程序坞和控制窗口；屏幕录制用于生成缩略图和读取窗口标题。"
          }
        }
      }
    },
    "Accessibility:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能："
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作"
          }
        }
      }
    },
    "Activation Delay": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活延迟"
          }
        }
      }
    },
    "Activation Delay:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活延迟："
          }
        }
      }
    },
