            "value": "桌面 %lld"
          }
        }
      }
    },
    "Desktop number and minimized badge": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面编号与最小化标记"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "zh-Hans": {
