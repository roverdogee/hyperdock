    "Turn this on if the Dock stutters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果程序坞出现卡顿，请打开此项。"
          }
        }
      }
    },
    "Two permissions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项权限"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "Welcome to HyperDock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 HyperDock"
          }
        }
      }
    },
    "Where to find it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在哪里找到它"
          }
        }
      }
    },
    "Window Management": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口管理"
          }
        }
      }
    },
    "Window Previews": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口预览"
          }
        }
      }
    },
    "Window Previews Off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口预览：关"
          }
        }
      }
    },
    "Window Previews On": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口预览：开"
          }
        }
      }
    },
    "Windows from all spaces": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有空间的窗口"
          }
        }
      }
    },
    "With these keys held, the arrows snap the focused window to each half of the screen, Return maximises it, the numeric keypad snaps to corners, and G tiles every window of the front app into a grid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住这些键时，方向键把当前窗口吸附到屏幕的各半边，回车最大化，小键盘吸附到四角，G 把前台应用的所有窗口排成网格。"
          }
        }
      }
    },
    "ms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毫秒"
          }
        }
      }
